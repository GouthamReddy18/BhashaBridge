# Baseline is default; no pretrained model is downloaded or loaded.
BHASHABRIDGE_ENV=development
BHASHABRIDGE_LID_PROVIDER=baseline
# Selective Romanized Telugu transliteration is disabled by default.
BHASHABRIDGE_TRANSLITERATION_ENABLED=false
# For optional local IndicLID FastText only, set provider=indic_lid and both paths:
# BHASHABRIDGE_INDICLID_FTN_PATH=C:\models\indiclid-ftn.bin
# BHASHABRIDGE_INDICLID_FTR_PATH=C:\models\indiclid-ftr.bin
# Google Cloud Translation Basic v2 is disabled by default. Before enabling,
# review provider billing/privacy documentation and obtain authorization to
# transmit the source text. API calls occur only when translation is requested.
# BHASHABRIDGE_GOOGLE_TRANSLATE_ENABLED=false
# BHASHABRIDGE_GOOGLE_TRANSLATE_API_KEY=
# BHASHABRIDGE_GOOGLE_TRANSLATE_MODEL=nmt
# BHASHABRIDGE_GOOGLE_TRANSLATE_TIMEOUT_SECONDS=10
