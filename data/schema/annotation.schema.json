{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bhashabridge:annotation:1.0",
  "title": "BhashaBridge annotation record v1.0",
  "description": "Structural per-record constraints. Python additionally enforces JSONL-wide IDs, duplicate object keys, project whitespace normalization, token boundaries/order/slices, unique candidate IDs, and cross-field provenance/review consistency.",
  "type": "object",
  "required": [
    "annotation_version",
    "id",
    "text",
    "normalized_text",
    "source_type",
    "annotation_status",
    "annotation_provenance",
    "tokens"
  ],
  "properties": {
    "annotation_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "split": {
      "enum": ["train", "validation", "test"]
    },
    "split_group": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "normalized_text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "source_type": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "annotation_status": {
      "enum": [
        "draft",
        "reviewed"
      ]
    },
    "annotation_provenance": {
      "type": "object",
      "required": [
        "method",
        "details",
        "origin"
      ],
      "properties": {
        "method": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "details": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "origin": {
          "enum": [
            "human",
            "machine",
            "human_and_machine"
          ]
        },
        "fields": {
          "type": "object",
          "properties": {
            "romanized_interpretation": {
              "type": "object",
              "required": [
                "origin",
                "review_status",
                "details"
              ],
              "properties": {
                "origin": {
                  "enum": [
                    "human",
                    "machine",
                    "human_and_machine"
                  ]
                },
                "review_status": {
                  "enum": [
                    "not_reviewed",
                    "reviewed"
                  ]
                },
                "details": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "source_reference": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              },
              "additionalProperties": false
            },
            "telugu_script_equivalent": {
              "type": "object",
              "required": [
                "origin",
                "review_status",
                "details"
              ],
              "properties": {
                "origin": {
                  "enum": [
                    "human",
                    "machine",
                    "human_and_machine"
                  ]
                },
                "review_status": {
                  "enum": [
                    "not_reviewed",
                    "reviewed"
                  ]
                },
                "details": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "source_reference": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              },
              "additionalProperties": false
            },
            "ambiguity": {
              "type": "object",
              "required": [
                "origin",
                "review_status",
                "details"
              ],
              "properties": {
                "origin": {
                  "enum": [
                    "human",
                    "machine",
                    "human_and_machine"
                  ]
                },
                "review_status": {
                  "enum": [
                    "not_reviewed",
                    "reviewed"
                  ]
                },
                "details": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "source_reference": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              },
              "additionalProperties": false
            },
            "reference_translation": {
              "type": "object",
              "required": [
                "origin",
                "review_status",
                "details"
              ],
              "properties": {
                "origin": {
                  "enum": [
                    "human",
                    "machine",
                    "human_and_machine"
                  ]
                },
                "review_status": {
                  "enum": [
                    "not_reviewed",
                    "reviewed"
                  ]
                },
                "details": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "source_reference": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              },
              "additionalProperties": false
            },
            "intended_meaning": {
              "type": "object",
              "required": ["origin", "review_status", "details"],
              "properties": {
                "origin": {"enum": ["human", "machine", "human_and_machine"]},
                "review_status": {"enum": ["not_reviewed", "reviewed"]},
                "details": {"type": "string", "minLength": 1, "pattern": "\\S"},
                "source_reference": {"type": "string", "minLength": 1, "pattern": "\\S"}
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "tokens": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "index",
          "surface",
          "start",
          "end",
          "language_label"
        ],
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0
          },
          "surface": {
            "type": "string",
            "minLength": 1
          },
          "start": {
            "type": "integer",
            "minimum": 0
          },
          "end": {
            "type": "integer",
            "minimum": 1
          },
          "language_label": {
            "enum": [
              "TELUGU_ROMANIZED",
              "TELUGU_SCRIPT",
              "ENGLISH",
              "PUNCTUATION",
              "NUMBER",
              "OTHER",
              "UNKNOWN"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "romanized_interpretation": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      ]
    },
    "telugu_script_equivalent": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      ]
    },
    "ambiguity": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "status",
            "candidates",
            "selected_candidate",
            "evidence",
            "rule_id"
          ],
          "properties": {
            "status": {
              "enum": [
                "detected",
                "resolved",
                "abstained"
              ]
            },
            "candidates": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "required": [
                  "candidate_id",
                  "meaning",
                  "source"
                ],
                "properties": {
                  "candidate_id": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "meaning": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "source": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  }
                },
                "additionalProperties": false
              }
            },
            "selected_candidate": {
              "type": [
                "string",
                "null"
              ]
            },
            "evidence": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "rule_id": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "resolved"
                  }
                },
                "required": [
                  "status"
                ]
              },
              "then": {
                "properties": {
                  "selected_candidate": {
                    "type": "string"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "status": {
                    "enum": [
                      "detected",
                      "abstained"
                    ]
                  }
                },
                "required": [
                  "status"
                ]
              },
              "then": {
                "properties": {
                  "selected_candidate": {
                    "type": "null"
                  }
                }
              }
            }
          ]
        }
      ]
    },
    "reference_translation": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      ]
    },
    "intended_meaning": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "minLength": 1, "pattern": "\\S"}
      ]
    },
    "annotation_notes": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "review": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "enum": [
                "not_reviewed",
                "reviewed",
                "disputed"
              ]
            },
            "reviewer_id": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "reviewed_at": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
              "format": "date"
            },
            "notes": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "additionalProperties": false
}
